{
  "name": "wonder-axi",
  "version": "0.1.0",
  "description": "AXI CLI that lets coding agents drive Wonder (wonder.design) canvases through Wonder's hosted MCP server without loading its tool schemas into context.",
  "keywords": [
    "agent",
    "axi",
    "cli",
    "design",
    "mcp",
    "wonder"
  ],
  "license": "MIT",
  "author": "Muhammad Masruri (masrurimz)",
  "repository": {
    "type": "git",
    "url": "https://github.com/masrurimz/wonder-axi.git"
  },
  "bin": {
    "wonder-axi": "dist/wonder-axi.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --target node --outfile dist/wonder-axi.js --banner '#!/usr/bin/env node' && chmod +x dist/wonder-axi.js",
    "lint": "oxlint",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt --write .",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict",
    "typecheck:fast": "bun check --no-script --threads 4",
    "test": "vitest run --maxWorkers=2",
    "check": "bun run lint && bun run fmt && bun run typecheck && bun run typecheck:fast && bun run test"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@toon-format/toon": "4.4.0",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@effect/vitest": "4.1.2",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "1.4.4",
    "@yielded/effect-tsrs": "0.2.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "ultracite": "8.0.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
